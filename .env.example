# Copy this file to .env.local and fill in your values.
# Never commit .env.local or real credentials to source control.
#
# Both values below are read by scripts/inject-oauth.js, which runs after
# `vite build` and writes them into dist/manifest.json. They are NOT needed for
# `npm run dev` — the dev build has no key and cannot authenticate with Drive.
# Either one may be left unset: the build prints a warning and continues.
#
# `npm run build` reads .env.local; `npm run build:prod` reads .env.prod.

# Google OAuth2 Client ID for the Drive sync feature.
# Obtain from https://console.cloud.google.com/apis/credentials (type: Chrome Extension).
# Without it, the sync UI renders but authentication fails.
TABNEST_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public half of the extension's signing key, from the Chrome Web Store item
# ("Public key" in the Package tab) or a locally generated .pem. Written to the
# manifest's "key" field so the build always gets the same extension ID — the
# OAuth client is tied to that ID, so Drive sync breaks without it.
# Base64, no "-----BEGIN PUBLIC KEY-----" wrapper and no line breaks.
GOOGLE_EXTENSION_KEY=your-base64-public-key
